{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GroundTruthCase",
  "description": "Schema for hidden ground truth cases in PW1C1-GT-v1.0.",
  "type": "object",
  "required": [
    "caseId",
    "difficultyLevel",
    "family",
    "events"
  ],
  "additionalProperties": false,
  "properties": {
    "caseId": {
      "type": "string",
      "pattern": "^CASE-[0-9]{2}$"
    },
    "difficultyLevel": {
      "type": "integer",
      "enum": [1, 2, 3]
    },
    "family": {
      "type": "string",
      "enum": [
        "independent_corroboration",
        "repost_echo_amplification",
        "mixed_lineage",
        "spatial_ambiguity",
        "conflicting_locations",
        "temporal_ambiguity",
        "nearby_separate_events",
        "sequential_late_evidence",
        "cross_modal_evidence"
      ]
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "trueEventId",
          "hazardType",
          "geometry",
          "eventStart",
          "eventEnd",
          "trueEventState",
          "evidenceIds",
          "independentLineageIds",
          "conflictingEvidenceIds"
        ],
        "additionalProperties": false,
        "properties": {
          "trueEventId": {
            "type": "string"
          },
          "hazardType": {
            "type": "string",
            "enum": [
              "landslide",
              "flash_flood",
              "flood",
              "cloudburst",
              "forest_fire",
              "avalanche",
              "earthquake",
              "road_blockage_infrastructure"
            ]
          },
          "geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": ["Point", "Polygon"]
              },
              "coordinates": {
                "type": "array"
              }
            }
          },
          "eventStart": {
            "type": "string",
            "format": "date-time"
          },
          "eventEnd": {
            "type": "string",
            "format": "date-time"
          },
          "trueEventState": {
            "type": "string",
            "enum": ["active", "resolved", "ongoing", "contained"]
          },
          "evidenceIds": {
            "type": "array",
            "items": { "type": "string" }
          },
          "independentLineageIds": {
            "type": "array",
            "items": { "type": "string" }
          },
          "conflictingEvidenceIds": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
